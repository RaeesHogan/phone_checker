# npm strict peer-dependency resolution is disabled for this project.
#
# @base-ui/react@1.5.0 declares an optional peer dependency on date-fns@^4,
# while the project pins date-fns@3.6.0. The optional peer is not used by
# the project, so the stricter npm resolver refuses to install without
# this flag. Vercel used to install with pnpm (which ignores the conflict),
# so this file keeps npm on the same, already-verified behaviour.
legacy-peer-deps=true
